{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "grammar",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "ai": { "binding": "AI" },
  // Shared Angelio store: family codes and daily safety caps (worker/codes.js).
  "kv_namespaces": [{ "binding": "CODES", "id": "a39d9bda676b420394c3eaba35975dec" }],
  "observability": { "enabled": true },
  // Lives at angelio.org through the hub. The old address redirects there with saved progress (worker/moved.js).
  "vars": { "HOME_URL": "https://angelio.org/grammar/", "STORE_KEY": "grammar:v1" },
  "workers_dev": true,
  "routes": [{ "pattern": "grammar.shalonely.com", "custom_domain": true }]
}
